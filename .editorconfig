# Same file format in every editor, so metrics never depend on who saved the file last
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,js}]
indent_size = 2

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
