{
  "uid": "plantshop-catalog",
  "title": "Plant Shop: catalog-service",
  "description": "Lab 7: RED metrics of catalog-service (Prometheus), pod resources and error logs (Loki)",
  "tags": ["plantshop", "lab7"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second (by status)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum by (status) (rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\"}[1m]))",
         "legendFormat": "{{status}}"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\"}[1m]))",
         "legendFormat": "total"}
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "5xx error share",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0,
        "custom": {"thresholdsStyle": {"mode": "line+area"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}},
        "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\"}[1m]))",
         "legendFormat": "5xx share"}
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 latency",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\"}[1m])))",
         "legendFormat": "p95 all routes"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\"}[1m])))",
         "legendFormat": "p95 {{uri}}"}
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "5xx per second by pod",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum by (pod) (rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\",status=~\"5..\"}[1m]))",
         "legendFormat": "{{pod}}"}
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests per second by ReplicaSet (pod-template hash)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum by (rollouts_pod_template_hash) (rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\"}[1m]))",
         "legendFormat": "RS {{rollouts_pod_template_hash}}"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Success rate (AnalysisTemplate query, threshold 95%)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1,
        "custom": {"thresholdsStyle": {"mode": "line+area"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.95}]}},
        "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\",status!~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{namespace=\"plantshop\",service=\"plantshop-catalog-service\",uri!~\"/actuator.*\"}[1m]))",
         "legendFormat": "success rate"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "CPU by pod (namespace plantshop)",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"plantshop\",container!=\"\"}[1m]))",
         "legendFormat": "{{pod}}"}
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Memory (working set) by pod",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"plantshop\",container!=\"\"})",
         "legendFormat": "{{pod}}"}
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "5xx log lines per minute by pod (Loki)",
      "gridPos": {"x": 0, "y": 32, "w": 24, "h": 7},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "loki", "uid": "loki"},
         "expr": "sum by (pod) (count_over_time({namespace=\"plantshop\", component=\"catalog-service\"} | json | status >= 500 [1m]))",
         "legendFormat": "{{pod}}"}
      ]
    },
    {
      "id": 10, "type": "logs", "title": "catalog-service error logs (Loki)",
      "gridPos": {"x": 0, "y": 39, "w": 24, "h": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {"showTime": true, "wrapLogMessage": false, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none"},
      "targets": [
        {"refId": "A", "datasource": {"type": "loki", "uid": "loki"},
         "expr": "{namespace=\"plantshop\", component=\"catalog-service\"} | json | log_level=\"ERROR\" | line_format \"{{.pod}} v{{.version}} {{.method}} {{.route}} -> {{.status}} ({{.duration_ms}} ms)\""}
      ]
    }
  ]
}
